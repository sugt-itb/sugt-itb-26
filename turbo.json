{
  "$schema": "https://v2-10-9.turborepo.dev/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"],
      "env": [
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "SUPABASE_URL",
        "SUPABASE_SERVICE_ROLE_KEY",
        "AGGREGATES_SECRET",
        "REVALIDATE_SECRET",
        "INTERNAL_APP_URL",
        "PUBLIC_APP_URL",
        "JADWAL_SHEET_CSV_URL",
        "GOOGLE_DRIVE_CLIENT_ID",
        "GOOGLE_DRIVE_CLIENT_SECRET",
        "GOOGLE_DRIVE_ACCOUNT_EMAIL",
        "DRIVE_TOKEN_KEY",
        "UNIFIED_DASHBOARD_JWT_SECRET",
        "UNIFIED_DASHBOARD_JWT_ISSUER",
        "UNIFIED_DASHBOARD_JWT_AUDIENCE"
      ]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "env": [
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "SUPABASE_URL",
        "SUPABASE_SERVICE_ROLE_KEY",
        "AGGREGATES_SECRET",
        "REVALIDATE_SECRET",
        "INTERNAL_APP_URL",
        "PUBLIC_APP_URL",
        "JADWAL_SHEET_CSV_URL",
        "GOOGLE_DRIVE_CLIENT_ID",
        "GOOGLE_DRIVE_CLIENT_SECRET",
        "GOOGLE_DRIVE_ACCOUNT_EMAIL",
        "DRIVE_TOKEN_KEY",
        "UNIFIED_DASHBOARD_JWT_SECRET",
        "UNIFIED_DASHBOARD_JWT_ISSUER",
        "UNIFIED_DASHBOARD_JWT_AUDIENCE"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "SUPABASE_URL",
        "SUPABASE_SERVICE_ROLE_KEY",
        "AGGREGATES_SECRET",
        "REVALIDATE_SECRET",
        "INTERNAL_APP_URL",
        "PUBLIC_APP_URL",
        "JADWAL_SHEET_CSV_URL",
        "GOOGLE_DRIVE_CLIENT_ID",
        "GOOGLE_DRIVE_CLIENT_SECRET",
        "GOOGLE_DRIVE_ACCOUNT_EMAIL",
        "DRIVE_TOKEN_KEY",
        "UNIFIED_DASHBOARD_JWT_SECRET",
        "UNIFIED_DASHBOARD_JWT_ISSUER",
        "UNIFIED_DASHBOARD_JWT_AUDIENCE"
      ]
    }
  }
}
